{
  "name": "civic-registry-transparency-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable civic infrastructure for public registries and transparency applications.",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @civic-registry/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node --test tests/database.integration.mjs",
    "db:migrate": "node packages/database/src/cli.ts migrate",
    "db:seed": "node packages/database/src/cli.ts seed",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate && pnpm test:db && pnpm build"
  }
}
